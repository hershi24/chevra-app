# Optional. The app runs fully without these using a local JSON store.

# HTML invitation sending (otherwise invitations are mocked with clickable preview links)
# Use RESEND_API_KEY2 when another app on the same host already owns RESEND_API_KEY.
RESEND_API_KEY2=
RESEND_API_KEY=
RESEND_FROM=מיין חברה <chevra@localhost>

# Optional shared secret for telephony / IVR providers (Twilio-style Bearer token)
IVR_WEBHOOK_SECRET=

# Live chat: copy these from Supabase → Project Settings → API
# After they are set, messages are written to Postgres and pushed to every
# open client through Realtime (postgres_changes). Without them the app
# keeps using the local JSON store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible). Files go to the bucket; metadata goes to Supabase media_files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
